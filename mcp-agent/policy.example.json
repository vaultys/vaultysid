{
  "version": "1.0",
  "scopes": {
    "fs.read": [
      "{{WORKSPACE}}/**"
    ],
    "fs.write": [
      "{{WORKSPACE}}/**"
    ],
    "fs.list": [
      "{{WORKSPACE}}/**"
    ],
    "proc.exec": [
      "ls",
      "cat",
      "echo",
      "wc",
      "head",
      "tail",
      "grep",
      "find"
    ],
    "net.egress.http": [
      "*"
    ]
  },
  "denied": [
    "secrets.*",
    "pkg.system",
    "proc.privilege"
  ],
  "constraints": {
    "max_runtime": 300,
    "no_shell_features": true
  }
}