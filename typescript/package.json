{
  "name": "@vaultys/id",
  "version": "3.0.0-beta8.0",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "browser": "./dist/browser/vaultysid.min.js",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    }
  },
  "main": "./dist/node/index.js",
  "module": "./dist/node/index.js",
  "browser": "./dist/browser/vaultysid.min.js",
  "types": "./dist/node/index.d.ts",
  "description": "the most advanced decentralised id framework",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:browser",
    "build:node": "rm -fr ./dist && tsc -p tsconfig.json",
    "build:browser": "webpack --config webpack.config.js",
    "prettier": "find src -name \"*.ts\" | xargs prettier --write",
    "test": "mocha ./test/*.test.[jt]s",
    "test:pqc": "mocha ./test/pqc.test.ts ",
    "test:server": "http-server . -p 8080",
    "test:web": "pnpm build:browser && webpack --config webpack.test.config.js && mocha --require tsx test/runner.ts",
    "visualize": "webpack --config webpack.config.js --json > stats.json",
    "test:compatibility:export": "pnpm run build:node && tsx test/interops/compatibility-export.ts",
    "test:compatibility:rust": "cd rust && cargo test --test typescript_compatibility",
    "test:compatibility": "pnpm run test:compatibility:export && npm run test:compatibility:rust",
    "test:interops:reverse": "test/interops/run-cross-language-test.sh reverse",
    "test:interops": "test/interops/run-cross-language-test.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
