    "@types/mocha": "^8.2.3",
    "@types/node": "^22.19.19",
    "@types/pbkdf2": "^3.1.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vaultys/id_2": "npm:@vaultys/id@2.4.10",
    "assert": "^2.1.0",
