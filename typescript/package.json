    "crypto-browserify": "^3.12.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "express": "^5.2.1",
    "http-server": "^14.1.1",
    "mocha": "^11.7.6",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "ts-loader": "^9.5.7",
